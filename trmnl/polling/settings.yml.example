# Reference: the same plugin configured for the Polling strategy, so it can be
# installed or forked without the user holding a plugin UUID.
#
# Requires the gh-pages JSON endpoint from ../.github/workflows/publish-json.yml.
# Put the URL you verified with `curl -sL` (HTTP 200, body starting {"area"}) in
# polling_url below. Do not guess a github.io path: an account-level custom
# domain 301-redirects every one of them. Published files: prices-pt.json,
# prices-es.json. If the polling preview shows no variables, serve an --envelope
# file instead: bash run.sh trmnl --area PT --envelope --out dist/prices-pt-envelope.json
#
# Paste these values into the plugin settings form. The Liquid markup in
# ../src/ is unchanged -- the JSON body is the same payload the webhook receives.
---
strategy: polling
polling_verb: get
polling_url: https://www.pedro-muller.com/trmnl-omie/prices-pt.json
polling_headers: ''
polling_body: ''
refresh_interval: 15
framework_version: 3.3.2
no_screen_padding: 'no'
dark_mode: 'no'
